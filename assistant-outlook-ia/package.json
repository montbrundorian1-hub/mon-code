{
  "name": "assistant-outlook-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Complément Outlook (Exchange On-Premises) de dictée et rédaction assistées par IA locale open source.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manifest": "node scripts/build-manifest.mjs",
    "e2e": "node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/office-js": "1.0.611",
    "@vitest/coverage-v8": "5.0.4",
    "axe-core": "4.10.3",
    "eslint": "10.12.0",
    "fast-xml-parser": "^5.3.0",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
