{
  "name": "assistant-outlook-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Complément Outlook (Exchange On-Premises) de dictée et rédaction assistées par IA locale open source.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manifest": "node scripts/build-manifest.mjs",
    "e2e": "node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@types/office-js": "1.0.611",
    "fast-xml-parser": "^5.3.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
